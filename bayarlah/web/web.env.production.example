# AWS Amplify environment variables — set in Amplify console (Hosting → Environment variables)
# For App Runner / ECS: set as task env vars or via AWS Secrets Manager

# Public origin of the API. Baked into the browser bundle at build time.
NEXT_PUBLIC_API_URL=https://your-backend.railway.app

# Optional: a private/internal API address used only when rendering on the server.
# API_URL=http://backend.internal:8000
