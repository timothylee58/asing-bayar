# Local development: copy to `.env` (Expo loads it automatically). Only EXPO_PUBLIC_* values
# reach the app, and they are visible to anyone who unpacks it: never put a secret here.

# Where the FastAPI backend runs. A physical phone cannot reach your computer's
# "localhost": use its LAN IP (e.g. http://192.168.1.20:8000) or a tunnel.
EXPO_PUBLIC_API_URL=http://localhost:8000

# Share-page origin used to build the links the organiser sends over WhatsApp.
EXPO_PUBLIC_WEB_URL=http://localhost:3000

# Supabase project used ONLY to sign organisers in (the app reads no tables directly).
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Release builds (EAS profiles preview/production) also need EAS_PROJECT_ID, and production
# needs GOOGLE_SERVICES_JSON (a file variable). Set all of these with `eas env:create`.
